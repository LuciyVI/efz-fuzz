#!/usr/bin/env escript
main(_) ->
    %% Reproducibly generate ordinary source, then use the normal EFZ compiler.
    Clauses = [io_lib:format("choose(~B) -> ~B;~n", [I, I * 3 + 1]) || I <- lists:seq(0, 2047)],
    Source = ["%% Generated by bench/generate_sparse.escript; ordinary local fixture.\n",
              "-module(efz_perf_sparse).\n-export([run/1]).\n",
              "run(<<N:16, _/binary>>) -> choose(N);\nrun(_) -> choose(0).\n", Clauses,
              "choose(_) -> outside.\n"],
    ok = file:write_file("fixtures/performance/efz_perf_sparse.erl", Source).
