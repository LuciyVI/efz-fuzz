#{target=>efz_persistent_fixture,
  artifacts_dir=>"_build/persistent-target-demo",
  seeds=>[<<"arm">>,<<"fire">>],
  mutation_mode=>staged,
  max_iterations=>0,
  timeout=>3000,
  execution=>#{mode=>persistent_vm,state_policy=>accumulate,
               max_iterations_per_epoch=>1000,max_journal_bytes=>16777216,
               durability=>buffered},
  runtime_oracles=>#{enabled=>true,
    resources=>#{enabled=>false},hangs=>#{enabled=>false},
    stability=>#{enabled=>true,max_extra_executions=>1000,
      sequence=>#{policy=>deferred,repeats=>3,max_calls=>1000,
                  max_elapsed_ms=>60000}}}}.
